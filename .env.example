# Copie este arquivo para ".env" (na raiz do projeto) e preencha.
# O arquivo .env não vai para o Git.

# Credenciais de acesso ao painel (autenticação básica do navegador)
DASHBOARD_USUARIO=mgi
DASHBOARD_SENHA=troque-esta-senha

# Opcional: chave fixa da sessão do Flask (se vazio, uma aleatória é gerada a cada início)
DASHBOARD_SECRET_KEY=
